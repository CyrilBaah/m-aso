# m’aso AI service settings. Copy to .env and adjust: cp .env.example .env

# faster-whisper model for live captions. On an 8 GB Apple Silicon Mac:
#   base.en  - fastest, rougher captions
#   small.en - good balance (default)
MASO_WHISPER_MODEL=small.en

# Web app origins allowed to call this service (comma-separated).
MASO_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Set to 0 to start without loading models (tests, UI-only work).
MASO_LOAD_MODELS=1
